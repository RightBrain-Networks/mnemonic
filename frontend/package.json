{
  "name": "mnemonic-dashboard",
  "version": "0.83.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:stack": "../scripts/test-e2e.sh",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-router": "1.170.44"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2"
  }
}
