# Create .env using python scripts/setup.py, or supply your own random secrets.
# Use a URL-safe database password: letters, digits, hyphens, underscores.
POSTGRES_PASSWORD=
MNEMONIC_API_KEY=

MNEMONIC_WEB_PORT=3000
MNEMONIC_API_PORT=8000
MNEMONIC_MCP_PORT=8001
MNEMONIC_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public HTTPS hostname, if you serve Mnemonic through deploy/nginx. Set this to
# your real hostname: compose.tls.yaml otherwise adds the placeholder below to
# the dashboard and MCP allowlists, and the dashboard answers 403 to its own API.
# MNEMONIC_TLS_HOST=mnemonic.example.com

# Maximum characters in new or changed work summaries. Positive integer; default 2048.
# Recreate API and web after changes; remote MCP clients use the API's limit.
# Existing summaries and completed operation receipts remain readable/replayable.
MNEMONIC_WORK_SUMMARY_MAX_CHARS=2048

# Server-controlled work-lease duration. Allowed range: 60 through 3600 seconds.
MNEMONIC_LEASE_TTL_SECONDS=900

# Maximum wait for a competing client-operation receipt. Allowed range: 1 through 10 seconds.
MNEMONIC_CLIENT_OPERATION_WAIT_SECONDS=10

# API image identity. Match the host transcript owner for private 0600 files.
# Changes require rebuilding the API and migrating artifact ownership; see
# docs/transcripts.md. Backup storage keeps its separate UID/GID 10001.
MNEMONIC_API_UID=10001
MNEMONIC_API_GID=10001

# Private host bind directory. Before starting Compose, create it with:
# sudo install -d -m 0700 -o 10001 -g 10001 ./artifacts
# Substitute MNEMONIC_API_UID/GID when customized; keep mode 0700.
MNEMONIC_ARTIFACT_DIR=./artifacts
# Upload limit in bytes (0 through 1073741824). Default: 67108864 = 64 MiB.
# Zero disables ALL artifact operations without deleting existing files or history.
# Recreate API and web after changing this value; MCP discovers API status per call.
# MCP base64 transfers also have an independent 64 MiB memory-safety ceiling.
MNEMONIC_ARTIFACT_MAX_BYTES=67108864

# Local Tika extraction safety budgets; recreate API and tika after changes.
# Characters retained per artifact (1..8000000); oversized extraction is reported
# as truncated. Existing completed extractions are not silently reprocessed.
MNEMONIC_ARTIFACT_EXTRACTION_MAX_CHARS=2000000
# Parser time budget per artifact (5..300 seconds). OCR is disabled.
MNEMONIC_ARTIFACT_EXTRACTION_TIMEOUT_SECONDS=60
# Compose owns the private parser URL. For non-Compose deployments only, set
# MNEMONIC_ARTIFACT_TIKA_URL to the origin of an equally isolated Tika 4 service.

# Agent transcripts: API-visible allowed roots, encoded as a JSON array.
# Empty denies filesystem reads until an operator supplies explicit roots.
# For Claude Code in Compose, set an absolute MNEMONIC_TRANSCRIPT_SOURCE_DIR
# and persist the overlay in COMPOSE_FILE so ordinary Compose commands keep
# the read-only mount at the SAME absolute path used by clients and its allowlist.
# Include compose.tls.yaml as well if using TLS. See docs/transcripts.md.
# COMPOSE_FILE=compose.yaml:compose.transcripts.yaml
# MNEMONIC_TRANSCRIPT_SOURCE_DIR=/home/your-user/.claude/projects
MNEMONIC_TRANSCRIPT_ALLOWED_ROOTS=[]
MNEMONIC_TRANSCRIPT_MAX_BYTES=67108864
# Maximum total indexed text searched per project/filter scope (1..2147483648).
# Default 512 MiB. Recreate API after changes. Text streams into the RAM index;
# cache hits only read bodies for returned-page snippets. See docs/transcripts.md.
MNEMONIC_TRANSCRIPT_SEARCH_MAX_BYTES=536870912
# Workspace settings can disable indexing or lower the per-file size limit.
# Extracted transcript text is retained in PostgreSQL and included in backups.

# Phase 9 Advisory safe-read limits. Values may be lowered where a range is
# shown, but the frozen release maxima cannot be raised by configuration.
# Accepted ranges: body exactly 2097152 bytes; request slots 1..4;
# request wait 1..250 ms; inference slots exactly 1 and shared with ordinary
# semantic search; inference wait 1..50 ms;
# shortlist 1..200; fill 1..128; population 1..10000; timeout 1..60 seconds.
MNEMONIC_DUPLICATE_SUGGESTION_BODY_MAX_BYTES=2097152
MNEMONIC_DUPLICATE_SUGGESTION_REQUEST_SLOTS=4
MNEMONIC_DUPLICATE_SUGGESTION_REQUEST_WAIT_MS=250
MNEMONIC_DUPLICATE_SUGGESTION_INFERENCE_SLOTS=1
MNEMONIC_DUPLICATE_SUGGESTION_INFERENCE_WAIT_MS=50
MNEMONIC_DUPLICATE_SUGGESTION_LEXICAL_SHORTLIST=200
MNEMONIC_DUPLICATE_SUGGESTION_MISSING_VECTOR_LIMIT=128
MNEMONIC_DUPLICATE_SUGGESTION_FULL_POPULATION_CEILING=10000
MNEMONIC_DUPLICATE_SUGGESTION_TIMEOUT_SECONDS=60

# PostgreSQL project backups at startup and every 24 hours, streamed through bzip2.
# Each project UUID has its own subdirectory; artifact FILES are excluded, but
# normalized extracted text and document metadata ARE included and may contain PII.
# Create this private bind with: sudo install -d -m 0700 -o 10001 -g 10001 ./backups
MNEMONIC_BACKUP_DIR=./backups
MNEMONIC_BACKUP_INTERVAL_SECONDS=86400
# Keep this many successful archives per project (1..10000).
MNEMONIC_BACKUP_RETENTION_COUNT=7
# Dashboard-only service credential. Never share it with the API or MCP service.
MNEMONIC_BACKUP_TOKEN=
# Maximum compressed archive/upload and expanded database data bytes.
MNEMONIC_BACKUP_MAX_BYTES=67108864
MNEMONIC_BACKUP_EXPANDED_MAX_BYTES=268435456

TIMEZONE=America/Detroit
