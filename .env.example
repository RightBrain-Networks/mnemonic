# Create .env using python scripts/setup.py, or supply your own random secrets.
# Use a URL-safe database password: letters, digits, hyphens, underscores.
POSTGRES_PASSWORD=
MNEMONIC_API_KEY=

MNEMONIC_WEB_PORT=3000
MNEMONIC_API_PORT=8000
MNEMONIC_MCP_PORT=8001
MNEMONIC_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public HTTPS hostname, if you serve Mnemonic through deploy/nginx. Set this to
# your real hostname: compose.tls.yaml otherwise adds the placeholder below to
# the dashboard and MCP allowlists, and the dashboard answers 403 to its own API.
# MNEMONIC_TLS_HOST=mnemonic.example.com

# Server-controlled work-lease duration. Allowed range: 60 through 3600 seconds.
MNEMONIC_LEASE_TTL_SECONDS=900

# Maximum wait for a competing client-operation receipt. Allowed range: 1 through 10 seconds.
MNEMONIC_CLIENT_OPERATION_WAIT_SECONDS=10

# New human-gate requests stay fenced until the coordinated Phase 7-8 cutover.
# Attention/history reads and direct REST/dashboard resolution remain available.
MNEMONIC_HUMAN_GATE_REQUESTS_ENABLED=false

# One verified dump at startup and every 24 hours. No automatic deletion.
# Set this to a private directory on another disk if desired; use forward slashes.
MNEMONIC_BACKUP_DIR=./backups
MNEMONIC_BACKUP_INTERVAL_SECONDS=86400

TIMEZONE=America/Detroit
