{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {"()": "uvicorn.logging.DefaultFormatter", "fmt": "%(levelprefix)s %(message)s"}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "formatter": "default", "stream": "ext://sys.stderr"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "mnemonic_api.semantic": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "mnemonic_api.search_timing": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "mnemonic_api.services.duplicate_suggestions": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "mnemonic_api.duplicate_embedding_jobs": {"handlers": ["default"], "level": "INFO", "propagate": false}
  }
}
