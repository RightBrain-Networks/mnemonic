  "rules": {
    "absolute_http_url_required": {
      "field": null,
      "message": "Include an absolute http:// or https:// URL."
    },
    "artifact_semantic_requires_fulltext": {
      "field": "fulltext",
      "message": "Artifact semantic search requires fulltext=true."
    },
    "artifact_semantic_requires_query_and_facet": {
      "field": "semantic",
      "message": "Artifact semantic search requires a nonblank q and the artifacts facet."
    },
    "canonical_filter_requires_alias_scope": {
      "field": "canonical_work_item_id",
      "message": "canonical_work_item_id requires duplicate_scope=aliases or all."
    },
    "content_kinds_requires_fulltext": {
      "field": "content_kinds",
      "message": "content_kinds requires fulltext=true."
    },
    "exact_query_requires_text": {
      "field": "q",
      "message": "Phrase and literal search require nonblank q."
    },
    "external_url_requires_full_view": {
      "field": "view",
      "message": "external_url requires view=full."
    },
    "query_phrase_requires_terms": {
      "field": "q",
      "message": "A phrase needs searchable words; use query_mode=literal for punctuation."
    },
    "roots_require_canonical_scope": {
      "field": "duplicate_scope",
      "message": "view=roots requires duplicate_scope=canonical."
    },
    "search_created_range_invalid": {
      "field": "created_before",
      "message": "created_before must be later than created_after; the upper bound is exclusive."
    },
    "search_datetime_timezone_required": {
      "field": null,
      "message": "Include a timezone offset or Z in each search date bound."
    },
    "search_projects_must_be_unique": {
      "field": "project_ids",
      "message": "project_ids must contain unique projects."
    },
    "search_updated_range_invalid": {
      "field": "updated_before",
      "message": "updated_before must be later than updated_after; the upper bound is exclusive."
    },
    "semantic_requires_all_work_fields": {
      "field": "work_fields",
      "message": "Semantic work search requires all work_fields; disable semantic to narrow fields."
    },
    "semantic_requires_query": {
      "field": "q",
      "message": "semantic=true requires a nonblank q."
    },
    "semantic_requires_unconstrained_artifact_query": {
      "field": "q",
      "message": "Semantic artifact search requires query_mode=terms without quoted phrases."
    },
    "semantic_requires_unconstrained_work_query": {
      "field": "q",
      "message": "Semantic work search requires query_mode=terms without quoted phrases."
    },
    "tag_counts_requires_work_facet": {
      "field": "tag_counts",
      "message": "tag_counts requires work_items in facets."
    },
    "unclosed_query_phrase": {
      "field": "q",
      "message": "Close each quoted phrase, or use query_mode=literal."
    },
    "view_requires_blank_query": {
      "field": "view",
      "message": "view=roots requires blank q; use view=full for text search."
    }
  }
}
